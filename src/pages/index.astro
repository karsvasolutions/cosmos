---
import '../styles/globals.css';
import Viewer from '../components/Viewer.astro';
import InfoSidebar from '../components/InfoSidebar.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>Cosmos</title>
    <meta name="description" content="High-resolution images from space." />
  </head>
  <body>
    <h1 class="sr-only">Cosmos — high-resolution images from space</h1>
    <p class="sr-only" id="kbd-help">
      Press right arrow to advance, left arrow to go back,
      space or p to play or pause the slideshow,
      i to toggle the description sidebar, escape to close.
    </p>
    <Viewer />
    <InfoSidebar />
  </body>
</html>
