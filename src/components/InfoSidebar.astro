---
---
<aside id="info-sidebar" class="sidebar" aria-label="Image description" aria-hidden="true">
  <button id="sidebar-close" class="sidebar-close" type="button" aria-label="Close description">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>
  <article class="sidebar-inner">
    <h2 id="sidebar-title" class="sidebar-title"></h2>
    <p class="sidebar-meta">
      <span id="sidebar-date"></span>
      <span class="sidebar-dot" aria-hidden="true">·</span>
      <a id="sidebar-link" target="_blank" rel="noreferrer noopener">view source</a>
    </p>
    <p id="sidebar-body" class="sidebar-body"></p>
    <p id="sidebar-credit" class="sidebar-credit"></p>
  </article>
</aside>

<script>
  import { mountInfoSidebar } from '../scripts/info-sidebar';
  mountInfoSidebar();
</script>

<style>
  .sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: var(--sidebar-width);
    box-sizing: border-box;
    padding: 40px;
    /* Slight lift from pure black so the panel reads as a distinct surface
       next to the image canvas. */
    background: #0a0a0f;
    border-right: 1px solid var(--hairline);
    color: var(--text-secondary);
    overflow-y: auto;
    z-index: 10;
    transform: translateX(-100%);
    transition: transform var(--motion-sidebar) ease-out;
    will-change: transform;

    /* Vertically center the content when it fits in one screen; auto
       margins collapse to 0 when content overflows, restoring natural
       scroll from the top. */
    display: flex;
    flex-direction: column;
  }
  :global(body.sidebar-open) .sidebar { transform: translateX(0); }

  .sidebar-inner {
    max-width: 52ch;
    margin-top: auto;
    margin-bottom: auto;
  }

  /* Close button — only on mobile + tablet (≤ 1024px), where the
     bottom-center info toggle is harder to reach because the sidebar
     covers most of the viewport. */
  .sidebar-close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(10, 10, 15, 0.65);
    border: 1px solid var(--hairline);
    color: var(--text-secondary);
    cursor: pointer;
    z-index: 1;
    transition: color var(--motion-cue) ease, background var(--motion-cue) ease;
  }
  .sidebar-close:hover,
  .sidebar-close:focus-visible {
    color: var(--text-primary);
    background: rgba(10, 10, 15, 0.85);
  }
  .sidebar-close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 1024px) {
    .sidebar-close { display: flex; }
  }

  /* Mobile: subtler treatment — strip the disc, just the cross. */
  @media (max-width: 767px) {
    .sidebar-close {
      width: auto;
      height: auto;
      padding: 8px;
      background: transparent;
      border: 0;
      color: var(--text-muted);
    }
    .sidebar-close:hover,
    .sidebar-close:focus-visible {
      background: transparent;
      color: var(--text-primary);
    }
  }

  .sidebar-title {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .sidebar-meta {
    margin: 0 0 22px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sidebar-dot { margin: 0 8px; opacity: 0.55; }
  #sidebar-link {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    transition: color var(--motion-cue) ease, border-color var(--motion-cue) ease;
  }
  #sidebar-link:hover,
  #sidebar-link:focus-visible {
    color: var(--text-primary);
    border-bottom-color: var(--text-secondary);
  }

  .sidebar-body {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.7;
  }

  .sidebar-credit {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Tablet + mobile (≤ 1024px): reserve vertical room at the top for
     the close button (16px from top, 36px tall = 52px) and at the
     bottom for the control cluster (which on medium sits at
     bottom: 48px + 44px height = 92px from viewport bottom). Generous
     buffer so a long title or last paragraph doesn't graze the chrome. */
  @media (max-width: 1024px) {
    .sidebar { padding: 80px 40px 100px; }
  }

  /* Mobile (≤ 767px): sidebar overlays the canvas at 88% width and the
     cluster sits higher (bottom: 72px → top edge at 112px from bottom),
     so bump the bottom padding accordingly. */
  @media (max-width: 767px) {
    .sidebar { width: 88%; padding: 80px 28px 120px; }
    .sidebar-title { font-size: 22px; }
    .sidebar-body { font-size: 14px; line-height: 1.65; }
  }

  /* Subtle scrollbar so it doesn't fight the design */
  .sidebar { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.18) transparent; }
  .sidebar::-webkit-scrollbar { width: 6px; }
  .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.18); border-radius: 3px; }
  .sidebar::-webkit-scrollbar-track { background: transparent; }

  @media (prefers-reduced-motion: reduce) {
    .sidebar { transition: transform 0.001ms; }
  }
</style>
