---
---
<aside id="info-sidebar" class="sidebar" aria-label="Image description" aria-hidden="true">
  <article class="sidebar-inner">
    <h2 id="sidebar-title" class="sidebar-title"></h2>
    <p class="sidebar-meta">
      <span id="sidebar-date"></span>
      <span class="sidebar-dot" aria-hidden="true">·</span>
      <a id="sidebar-link" target="_blank" rel="noreferrer noopener">view source</a>
    </p>
    <p id="sidebar-body" class="sidebar-body"></p>
    <p id="sidebar-credit" class="sidebar-credit"></p>
  </article>
</aside>

<script>
  import { mountInfoSidebar } from '../scripts/info-sidebar';
  mountInfoSidebar();
</script>

<style>
  .sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: var(--sidebar-width);
    box-sizing: border-box;
    padding: 56px 40px 40px;
    /* Slight lift from pure black so the panel reads as a distinct surface
       next to the image canvas. */
    background: #0a0a0f;
    border-right: 1px solid var(--hairline);
    color: var(--text-secondary);
    overflow-y: auto;
    z-index: 10;
    transform: translateX(-100%);
    transition: transform var(--motion-sidebar) ease-out;
    will-change: transform;
  }
  :global(body.sidebar-open) .sidebar { transform: translateX(0); }

  .sidebar-inner { max-width: 52ch; }

  .sidebar-title {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .sidebar-meta {
    margin: 0 0 22px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sidebar-dot { margin: 0 8px; opacity: 0.55; }
  #sidebar-link {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    transition: color var(--motion-cue) ease, border-color var(--motion-cue) ease;
  }
  #sidebar-link:hover,
  #sidebar-link:focus-visible {
    color: var(--text-primary);
    border-bottom-color: var(--text-secondary);
  }

  .sidebar-body {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.7;
  }

  .sidebar-credit {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Below tablet: overlay at 88% width, image is NOT pushed. */
  @media (max-width: 767px) {
    .sidebar { width: 88%; padding: 40px 28px 32px; }
    .sidebar-title { font-size: 22px; }
    .sidebar-body { font-size: 14px; line-height: 1.65; }
  }

  /* Subtle scrollbar so it doesn't fight the design */
  .sidebar { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.18) transparent; }
  .sidebar::-webkit-scrollbar { width: 6px; }
  .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.18); border-radius: 3px; }
  .sidebar::-webkit-scrollbar-track { background: transparent; }

  @media (prefers-reduced-motion: reduce) {
    .sidebar { transition: transform 0.001ms; }
  }
</style>
