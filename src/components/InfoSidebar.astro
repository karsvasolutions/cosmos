---
---
<aside id="info-sidebar" class="sidebar" aria-label="Image description" aria-hidden="true">
  <button id="sidebar-close" class="sidebar-close" type="button" aria-label="Close description">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>

  <header class="sidebar-header">
    <h2 id="sidebar-title" class="sidebar-title"></h2>
    <p class="sidebar-meta">
      <span id="sidebar-date"></span>
      <span class="sidebar-dot" aria-hidden="true">·</span>
      <a id="sidebar-link" target="_blank" rel="noreferrer noopener">view source</a>
    </p>
  </header>

  <div class="sidebar-scroll">
    <div class="sidebar-scroll-inner">
      <p id="sidebar-body" class="sidebar-body"></p>
      <p id="sidebar-credit" class="sidebar-credit"></p>
    </div>
  </div>
</aside>

<script>
  import { mountInfoSidebar } from '../scripts/info-sidebar';
  mountInfoSidebar();
</script>

<style>
  .sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: var(--sidebar-width);
    box-sizing: border-box;
    padding: 56px 40px 40px;
    background: #0a0a0f;
    border-right: 1px solid var(--hairline);
    color: var(--text-secondary);
    z-index: 10;
    transform: translateX(-100%);
    transition: transform var(--motion-sidebar) ease-out;
    will-change: transform;

    /* Fixed header + scrollable body inside a flex column.
       The header sticks to the top of the inner padded area; the
       scroll body takes the remaining height. */
    display: flex;
    flex-direction: column;
  }
  :global(body.sidebar-open) .sidebar { transform: translateX(0); }

  .sidebar-header {
    flex: 0 0 auto;
    max-width: 52ch;
  }

  .sidebar-scroll {
    flex: 1 1 auto;
    min-height: 0;  /* required for flex children to allow shrinking */
    overflow-y: auto;
    max-width: 52ch;

    /* Make the scroll area itself a flex column so the inner block
       can use auto margins to vertically center when it fits. */
    display: flex;
    flex-direction: column;
  }

  /* Desktop: vertically center the description block when it fits.
     Auto margins collapse to 0 when content overflows, restoring
     natural top-aligned scroll from the top. On mobile / tablet keep
     top-alignment so the description reads predictably from the top
     of the panel. */
  @media (min-width: 1025px) {
    .sidebar-scroll-inner {
      margin-top: auto;
      margin-bottom: auto;
    }
  }

  /* Close × — always visible, always a bare cross (no disc). */
  .sidebar-close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: transparent;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
    z-index: 2;
    transition: color var(--motion-cue) ease;
  }
  .sidebar-close:hover,
  .sidebar-close:focus-visible {
    color: var(--text-primary);
  }
  .sidebar-close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sidebar-title {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .sidebar-meta {
    margin: 0 0 22px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sidebar-dot { margin: 0 8px; opacity: 0.55; }
  #sidebar-link {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    transition: color var(--motion-cue) ease, border-color var(--motion-cue) ease;
  }
  #sidebar-link:hover,
  #sidebar-link:focus-visible {
    color: var(--text-primary);
    border-bottom-color: var(--text-secondary);
  }

  .sidebar-body {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.7;
  }

  .sidebar-credit {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Tablet + mobile (≤ 1024px): reserve top room for the close button
     (16px from top, 32px tall = 48px) and bottom room for the control
     cluster (medium: bottom: 48px + 44px height = 92px from viewport
     bottom). The header sits at the top of the padded area; the
     scroll body ends at the bottom of the padded area. */
  @media (max-width: 1024px) {
    .sidebar { padding: 56px 40px 100px; }
  }

  /* Mobile (≤ 767px): sidebar overlays the canvas at 88% width.
     The control cluster is hidden when sidebar is open here, so we
     only need the close-button top clearance — bottom can be tighter. */
  @media (max-width: 767px) {
    .sidebar { width: 88%; padding: 56px 28px 32px; }
    .sidebar-title { font-size: 22px; }
    .sidebar-body { font-size: 14px; line-height: 1.65; }
  }

  /* Subtle scrollbar inside the scrollable body */
  .sidebar-scroll { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.18) transparent; }
  .sidebar-scroll::-webkit-scrollbar { width: 6px; }
  .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.18); border-radius: 3px; }
  .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }

  @media (prefers-reduced-motion: reduce) {
    .sidebar { transition: transform 0.001ms; }
  }
</style>
