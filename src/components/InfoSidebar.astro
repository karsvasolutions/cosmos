---
---
<aside id="info-sidebar" class="sidebar" aria-label="Image description" aria-hidden="true">
  <button id="sidebar-close" class="sidebar-close" type="button" aria-label="Close description">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>

  <header class="sidebar-header">
    <h2 id="sidebar-title" class="sidebar-title"></h2>
    <p class="sidebar-meta">
      <span id="sidebar-date"></span>
      <span class="sidebar-dot" aria-hidden="true">·</span>
      <a id="sidebar-link" target="_blank" rel="noreferrer noopener">view source</a>
    </p>
  </header>

  <div class="sidebar-scroll">
    <div class="sidebar-scroll-inner">
      <p id="sidebar-body" class="sidebar-body"></p>
      <p id="sidebar-credit" class="sidebar-credit"></p>
    </div>
  </div>
</aside>

<script>
  import { mountInfoSidebar } from '../scripts/info-sidebar';
  mountInfoSidebar();
</script>

<style>
  /* Base (mobile): fixed header at top + scrollable body below.
     On ≥ 768 px (tablet + desktop), this switches to vertically
     centering the whole content block — see media query below. */
  .sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: var(--sidebar-width);
    box-sizing: border-box;
    padding: 56px 40px 40px;
    background: #0a0a0f;
    border-right: 1px solid var(--hairline);
    color: var(--text-secondary);
    z-index: 10;
    transform: translateX(-100%);
    transition: transform var(--motion-sidebar) ease-out;
    will-change: transform;

    display: flex;
    flex-direction: column;
  }
  :global(body.sidebar-open) .sidebar { transform: translateX(0); }

  .sidebar-header {
    flex: 0 0 auto;
    max-width: 52ch;
  }

  .sidebar-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    max-width: 52ch;
  }

  /* Tablet + desktop (≥ 768 px): vertically center the WHOLE content
     block. The sidebar itself becomes the scroll container; auto
     margins on header (top) and scroll wrapper (bottom) push the
     block to the middle. */
  @media (min-width: 768px) {
    .sidebar {
      padding: 40px;
      overflow-y: auto;
    }
    .sidebar-header { margin-top: auto; }
    .sidebar-scroll {
      flex: 0 0 auto;
      overflow: visible;
      margin-bottom: auto;
    }
  }

  /* Close × — always visible, always a bare cross (no disc). */
  .sidebar-close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: transparent;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
    z-index: 2;
    transition: color var(--motion-cue) ease;
  }
  .sidebar-close:hover,
  .sidebar-close:focus-visible {
    color: var(--text-primary);
  }
  .sidebar-close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sidebar-title {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .sidebar-meta {
    margin: 0 0 22px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sidebar-dot { margin: 0 8px; opacity: 0.55; }
  #sidebar-link {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    transition: color var(--motion-cue) ease, border-color var(--motion-cue) ease;
  }
  #sidebar-link:hover,
  #sidebar-link:focus-visible {
    color: var(--text-primary);
    border-bottom-color: var(--text-secondary);
  }

  .sidebar-body {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.7;
  }

  .sidebar-credit {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Mobile (≤ 767 px): sidebar overlays the canvas at 88% width.
     Keep the fixed-header pattern (set in base rules) and tighten the
     side padding + type sizes for the narrower viewport. */
  @media (max-width: 767px) {
    .sidebar { width: 88%; padding: 56px 28px 32px; }
    .sidebar-title { font-size: 22px; }
    .sidebar-body { font-size: 14px; line-height: 1.65; }
  }

  /* Subtle scrollbar — applied to whichever element actually scrolls
     (the sidebar itself on desktop, the inner body region elsewhere). */
  .sidebar-scroll,
  .sidebar { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.18) transparent; }
  .sidebar-scroll::-webkit-scrollbar,
  .sidebar::-webkit-scrollbar { width: 6px; }
  .sidebar-scroll::-webkit-scrollbar-thumb,
  .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.18); border-radius: 3px; }
  .sidebar-scroll::-webkit-scrollbar-track,
  .sidebar::-webkit-scrollbar-track { background: transparent; }

  @media (prefers-reduced-motion: reduce) {
    .sidebar { transition: transform 0.001ms; }
  }
</style>
