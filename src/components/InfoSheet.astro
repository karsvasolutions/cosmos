---
---
<dialog id="info-sheet" class="sheet" aria-labelledby="sheet-title">
  <article>
    <h2 id="sheet-title" class="sheet-title"></h2>
    <p class="sheet-meta">
      <span id="sheet-date"></span>
      <span class="sheet-dot" aria-hidden="true">·</span>
      <a id="sheet-link" target="_blank" rel="noreferrer noopener">view source</a>
    </p>
    <p id="sheet-body" class="sheet-body"></p>
    <p id="sheet-credit" class="sheet-credit"></p>
  </article>
  <button id="sheet-close" class="sheet-close" type="button" aria-label="Close description">
    close
  </button>
</dialog>

<script>
  import { mountInfoSheet } from '../scripts/info-sheet';
  mountInfoSheet();
</script>

<style>
  .sheet {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    top: auto;
    width: 100%;
    max-width: none;
    max-height: 55vh;
    margin: 0;
    padding: 32px 32px 48px;
    border: 0;
    border-top: 1px solid var(--hairline);
    background: var(--sheet-bg);
    backdrop-filter: blur(8px);
    color: var(--text-secondary);
    box-sizing: border-box;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform var(--motion-sheet) ease-out;
  }
  .sheet[open] { transform: translateY(0); }
  .sheet::backdrop { background: transparent; }

  .sheet-title {
    margin: 0 0 12px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .sheet-meta {
    margin: 0 0 18px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sheet-dot { margin: 0 8px; opacity: 0.6; }
  .sheet-link, #sheet-link { text-decoration: none; border-bottom: 1px solid var(--hairline); }
  .sheet-body {
    margin: 0 0 18px;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.65;
  }
  .sheet-credit {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .sheet-close {
    position: absolute;
    top: 16px; right: 24px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .sheet-close:hover, .sheet-close:focus-visible { color: var(--text-primary); }

  @media (max-width: 480px) {
    .sheet { padding: 24px 18px 32px; max-height: 70vh; }
  }
</style>
