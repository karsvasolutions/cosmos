---
import images from '../../data/images.json';
---
<div id="viewer" class="viewer">
  <!-- Both slides start invisible (opacity: 0). The runtime fades the
       first one in on load via the same transition that swap() uses
       so the page never shows a progressive top-to-bottom JPEG render. -->
  <img class="slide slide-a" alt="" decoding="async" />
  <img class="slide slide-b" alt="" decoding="async" />

  <div class="chrome chrome-credit" aria-hidden="true">
    <span id="credit-text"></span>
  </div>

  <div class="loader" aria-hidden="true">
    <svg class="loader-constellation" viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg">
      <polyline class="constellation-line"
                points="8,36 18,18 28,32 40,12 50,30"
                fill="none"
                stroke="rgba(255, 255, 255, 0.55)"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round" />
      <circle cx="8"  cy="36" r="1.3" fill="#fff"/>
      <circle cx="18" cy="18" r="1.3" fill="#fff"/>
      <circle cx="28" cy="32" r="1.3" fill="#fff"/>
      <circle cx="40" cy="12" r="1.3" fill="#fff"/>
      <circle cx="50" cy="30" r="1.3" fill="#fff"/>
    </svg>
  </div>
</div>

<!-- Controls live OUTSIDE the viewer so they stay fixed to the viewport
     and don't shift when the sidebar pushes the canvas right. -->
<div id="controls" class="controls" aria-hidden="true">
  <div class="ctrl-row">
    <button id="ctrl-info" class="ctrl ctrl-center ctrl-info" type="button"
            aria-label="Show image description"
            aria-haspopup="dialog" aria-controls="info-sidebar">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 16v-4"/>
        <path d="M12 8h.01"/>
      </svg>
    </button>
    <button id="ctrl-prev" class="ctrl ctrl-center ctrl-prev" type="button" aria-label="Previous image">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button id="ctrl-play" class="ctrl ctrl-center ctrl-play" type="button" aria-label="Play slideshow">
      <svg class="icon icon-play" viewBox="0 0 24 24" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg>
      <svg class="icon icon-pause" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="6" y="4" width="4" height="16" rx="1"/>
        <rect x="14" y="4" width="4" height="16" rx="1"/>
      </svg>
    </button>
    <button id="ctrl-speed" class="ctrl ctrl-center ctrl-speed" type="button"
            aria-label="Slide interval: 8 seconds. Click to change.">
      <span id="ctrl-speed-label">8s</span>
    </button>
    <button id="ctrl-next" class="ctrl ctrl-center ctrl-next" type="button" aria-label="Next image">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <button id="ctrl-fullscreen" class="ctrl ctrl-center ctrl-fullscreen" type="button" aria-label="Enter fullscreen">
      <svg class="icon icon-maximize" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 3H5a2 2 0 0 0-2 2v3"/>
        <path d="M21 8V5a2 2 0 0 0-2-2h-3"/>
        <path d="M3 16v3a2 2 0 0 0 2 2h3"/>
        <path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
      </svg>
      <svg class="icon icon-minimize" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 3v3a2 2 0 0 1-2 2H3"/>
        <path d="M21 8h-3a2 2 0 0 1-2-2V3"/>
        <path d="M3 16h3a2 2 0 0 1 2 2v3"/>
        <path d="M16 21v-3a2 2 0 0 1 2-2h3"/>
      </svg>
    </button>
  </div>
</div>

<script id="images-data" type="application/json" set:html={JSON.stringify(images)} />

<script>
  import { mountViewer } from '../scripts/viewer';
  mountViewer();
</script>

<style>
  .viewer {
    position: fixed;
    inset: 0;
    background: var(--canvas);
    transition: left var(--motion-sidebar) ease-out;
  }
  /* When the sidebar is open on tablet+, push the canvas right by the
     golden-ratio amount so image + sidebar share the screen. */
  :global(body.sidebar-open) .viewer {
    left: var(--sidebar-width);
  }
  @media (max-width: 767px) {
    :global(body.sidebar-open) .viewer { left: 0; }
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity var(--motion-fade) ease-in-out;
  }
  .slide.is-active { opacity: 1; }

  /* Loading spinner — appears only after the load has been in flight
     for ~250 ms so quick swaps don't flash a spinner. Fades out
     instantly when loading completes. */
  .loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease 0ms;
  }
  :global(body.is-loading) .loader {
    opacity: 1;
    transition: opacity 200ms ease 250ms;
  }
  /* Constellation loader: a small 5-star figure that draws itself in
     between the stars, holds, then fades out, looping forever.
     The stars themselves gently twinkle at staggered phases so the
     "sky" feels alive even when the line isn't being drawn. */
  .loader-constellation {
    width: 56px;
    height: 56px;
    overflow: visible;
  }
  .constellation-line {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: cosmos-draw 3.4s ease-in-out infinite;
  }
  .loader-constellation circle {
    animation: cosmos-twinkle 3s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  .loader-constellation circle:nth-of-type(1) { animation-delay: 0s; }
  .loader-constellation circle:nth-of-type(2) { animation-delay: -0.6s; }
  .loader-constellation circle:nth-of-type(3) { animation-delay: -1.2s; }
  .loader-constellation circle:nth-of-type(4) { animation-delay: -1.8s; }
  .loader-constellation circle:nth-of-type(5) { animation-delay: -2.4s; }

  @keyframes cosmos-draw {
    0%   { stroke-dashoffset: 200; opacity: 1; }
    45%  { stroke-dashoffset: 0;   opacity: 1; }
    80%  { stroke-dashoffset: 0;   opacity: 1; }
    100% { stroke-dashoffset: 0;   opacity: 0; }
  }
  @keyframes cosmos-twinkle {
    0%, 100% { opacity: 0.5; }
    50%      { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .constellation-line,
    .loader-constellation circle { animation: none; }
    .constellation-line { stroke-dashoffset: 0; opacity: 1; }
  }

  .chrome {
    position: absolute;
    bottom: 18px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    user-select: none;
    transition: opacity var(--motion-cue) ease;
  }
  .chrome-credit {
    left: 24px;
    /* Coordinate the fade with the sidebar slide-in so they feel like
       one motion rather than two. */
    transition: opacity var(--motion-sidebar) ease-out;
  }
  /* The title is already prominent in the sidebar header, so hide the
     bottom-left credit while the sidebar is open. */
  :global(body.sidebar-open) .chrome-credit { opacity: 0; }

  /* Slideshow controls — fixed to the viewport (NOT inside .viewer)
     so they stay put when the sidebar pushes the canvas. */
  .controls {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--motion-cue) ease;
    /* Stay above the sidebar so the info button remains clickable
       even on narrow viewports where the cluster might brush the
       sidebar's right edge. */
    z-index: 20;
  }
  .controls.is-visible { opacity: 1; }
  .controls.is-visible .ctrl { pointer-events: auto; }

  .ctrl {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(10, 10, 15, 0.65);
    backdrop-filter: blur(8px);
    border: 1px solid var(--hairline);
    color: var(--text-secondary);
    cursor: pointer;
    transition: color var(--motion-cue) ease, background var(--motion-cue) ease, transform var(--motion-cue) ease;
  }
  .ctrl:not(:disabled):hover,
  .ctrl:not(:disabled):focus-visible {
    color: var(--text-primary);
    background: rgba(10, 10, 15, 0.85);
  }
  .ctrl:not(:disabled):active { transform: scale(0.96); }
  .ctrl:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* Lucide-style line icons — single weight, rounded joins */
  .icon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Play and pause read better as filled silhouettes (media convention)
     while the rest stay as line icons. */
  .icon-play { fill: currentColor; stroke: none; width: 16px; height: 16px; }
  .icon-play polygon { /* keep filled */ }
  .icon-pause { fill: currentColor; stroke: none; }

  /* Centered cluster: info · prev · play · next */
  .ctrl-row {
    position: absolute;
    left: 50%;
    bottom: 32px;  /* large screens (> 1024px) */
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ctrl-center { position: static; }
  /* Visual hierarchy: info quiet on the left edge, media controls bright */
  .ctrl-prev,
  .ctrl-play,
  .ctrl-next,
  .ctrl-speed,
  .ctrl-fullscreen {
    color: var(--text-primary);
  }
  /* Small extra breathing room separating the info button on the left
     and the fullscreen button on the right from the media controls. */
  .ctrl-info { margin-right: 4px; }
  .ctrl-fullscreen { margin-left: 4px; }

  /* Speed button is text, not an icon */
  .ctrl-speed {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
  }

  /* Play/pause toggle: show the right glyph based on state */
  .ctrl-play .icon-pause { display: none; }
  .ctrl-play.is-playing .icon-play { display: none; }
  .ctrl-play.is-playing .icon-pause { display: block; }

  /* Fullscreen toggle: enter / exit glyphs */
  .ctrl-fullscreen .icon-minimize { display: none; }
  .ctrl-fullscreen.is-fullscreen .icon-maximize { display: none; }
  .ctrl-fullscreen.is-fullscreen .icon-minimize { display: block; }

  /* Medium (≤ 1024px): lift the cluster a bit higher off the bottom. */
  @media (max-width: 1024px) {
    .ctrl-row { bottom: 48px; }
  }

  /* Mobile (≤ 767px): when the sidebar is open it covers most of the
     viewport, so hide the bottom-center control cluster — the user
     navigates via the sidebar's close button and swipe instead. */
  @media (max-width: 767px) {
    :global(body.sidebar-open) .controls {
      opacity: 0;
      pointer-events: none;
    }
  }

  /* Mobile (≤ 480px): smaller buttons, tighter gap, even higher cluster. */
  @media (max-width: 480px) {
    .chrome-credit {
      left: 16px;
      max-width: calc(100vw - 32px);
    }
    .ctrl { width: 40px; height: 40px; }
    .icon { width: 16px; height: 16px; }
    .icon-play { width: 14px; height: 14px; }
    .ctrl-row { bottom: 72px; gap: 10px; }
  }
</style>
