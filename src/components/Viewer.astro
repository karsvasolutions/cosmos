---
import images from '../../data/images.json';
---
<div id="viewer" class="viewer">
  <img class="slide slide-a is-active" alt="" decoding="async" />
  <img class="slide slide-b" alt="" decoding="async" />

  <div class="chrome chrome-credit" aria-hidden="true">
    <span id="credit-text"></span>
  </div>

  <div id="controls" class="controls" aria-hidden="true">
    <button id="ctrl-prev" class="ctrl ctrl-side ctrl-prev" type="button" aria-label="Previous image">
      <span aria-hidden="true">‹</span>
    </button>
    <button id="ctrl-next" class="ctrl ctrl-side ctrl-next" type="button" aria-label="Next image">
      <span aria-hidden="true">›</span>
    </button>
    <div class="ctrl-row">
      <button id="ctrl-info" class="ctrl ctrl-center ctrl-info" type="button"
              aria-label="Show image description"
              aria-haspopup="dialog" aria-controls="info-sheet">
        <span aria-hidden="true">i</span>
      </button>
      <button id="ctrl-play" class="ctrl ctrl-center ctrl-play" type="button" aria-label="Play slideshow">
        <span id="ctrl-play-glyph" aria-hidden="true">▶</span>
      </button>
    </div>
  </div>
</div>

<script id="images-data" type="application/json" set:html={JSON.stringify(images)} />

<script>
  import { mountViewer } from '../scripts/viewer';
  mountViewer();
</script>

<style>
  .viewer {
    position: fixed;
    inset: 0;
    background: var(--canvas);
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity var(--motion-fade) ease-in-out;
  }
  .slide.is-active { opacity: 1; }

  .chrome {
    position: absolute;
    bottom: 18px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    user-select: none;
    transition: opacity var(--motion-cue) ease;
  }
  .chrome-credit { left: 24px; }

  /* Slideshow controls */
  .controls {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--motion-cue) ease;
  }
  .controls.is-visible {
    opacity: 1;
  }
  .controls.is-visible .ctrl {
    pointer-events: auto;
  }

  .ctrl {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(10, 10, 15, 0.65);
    backdrop-filter: blur(8px);
    border: 1px solid var(--hairline);
    color: var(--text-secondary);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: color var(--motion-cue) ease, background var(--motion-cue) ease, transform var(--motion-cue) ease;
  }
  .ctrl:hover,
  .ctrl:focus-visible {
    color: var(--text-primary);
    background: rgba(10, 10, 15, 0.85);
  }
  .ctrl:active { transform: scale(0.96); }

  .ctrl-side {
    top: 50%;
    transform: translateY(-50%);
  }
  .ctrl-side:active { transform: translateY(-50%) scale(0.96); }
  .ctrl-prev { left: 18px; }
  .ctrl-next { right: 18px; }
  .ctrl-prev span, .ctrl-next span {
    /* nudge glyph to optical center */
    transform: translateY(-1px);
  }

  /* Centered cluster: info + play, side by side */
  .ctrl-row {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
  }
  .ctrl-center { position: static; }
  .ctrl-info,
  .ctrl-play {
    color: var(--text-primary);
  }
  .ctrl-info {
    /* Bold sans-serif "i" reads clearly as an info indicator —
       same visual weight as the play glyph next to it. */
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 18px;
    line-height: 1;
  }
  .ctrl-info span {
    /* slight optical nudge */
    transform: translateY(-1px);
    display: inline-block;
  }
  .ctrl-play {
    font-size: 14px;
  }
  .ctrl-play.is-playing #ctrl-play-glyph {
    letter-spacing: 0.06em;
  }

  @media (max-width: 480px) {
    .chrome-credit { left: 16px; max-width: calc(100vw - 32px); }
    .ctrl { width: 40px; height: 40px; font-size: 20px; }
    .ctrl-info { font-size: 16px; }
    .ctrl-prev { left: 10px; }
    .ctrl-next { right: 10px; }
    .ctrl-row { bottom: 20px; gap: 10px; }
  }
</style>
